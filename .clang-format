# Custom configuration: Allman style, real TABS.
BasedOnStyle: LLVM

# Language specifications
Language: Cpp

# Tab and Indentation configurations (Using actual TABS)
ColumnLimit: 100
TabWidth: 4
IndentWidth: 4
UseTab: Always
IndentCaseLabels: true
NamespaceIndentation: All

# Brace breaking styles (Allman)
BreakBeforeBraces: Allman

# Function Signatures & Arguments
AlwaysBreakAfterReturnType: None
AlignAfterOpenBracket: BlockIndent
AllowAllParametersOfDeclarationOnNextLine: true
BinPackParameters: false

# Constructor Initializers
PackConstructorInitializers: BinPack

# Alignment of consecutive declarations
AlignConsecutiveDeclarations: true
BinPackInits: false
AlignConsecutiveAssignments: false

# Secondary alignments
AlignOperands: true
AlignTrailingComments: true

# Pointer and reference alignment
PointerAlignment: Right

# Spaces configurations
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1

# Qualifier order
QualifierAlignment: Custom
QualifierOrder: ['inline', 'static', 'type', 'const', 'volatile']

# Include sorting and cleanup
FixNamespaceComments: true
SortIncludes: true